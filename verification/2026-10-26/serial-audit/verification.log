def Erdos143.MainConclusion : Prop :=
∃ A, A.Countable ∧ (∀ a ∈ A, 2 ≤ a) ∧ Erdos143.Original A ∧ Erdos143.totalWeight A = ⊤
def Erdos143.StrongConclusion : Prop :=
∃ A,
  A.Countable ∧
    (∀ a ∈ A, 2 ≤ a) ∧
      Erdos143.Original A ∧
        Erdos143.totalWeight A = ⊤ ∧ Erdos143.LocallyFiniteAbove A ∧ ∀ a ∈ A, Erdos143.TinyPositiveDisplacement a
Erdos143.mainConclusion_proved : Erdos143.MainConclusion
Erdos143.strongConclusion_proved : Erdos143.StrongConclusion
Erdos143.realConclusion_proved :
  ∃ A,
    A.Countable ∧
      A ⊆ Set.Ici 2 ∧
        (∀ a ∈ A, ∃ q, a = ↑q) ∧
          (∀ a ∈ A, ∀ b ∈ A, a ≠ b → ∀ (k : ℕ), 1 ≤ k → 1 ≤ |↑k * a - b|) ∧
            ∑' (a : ↑A), ENNReal.ofReal (1 / (↑a * Real.log ↑a)) = ⊤ ∧ ¬Summable fun a => 1 / (↑a * Real.log ↑a)
